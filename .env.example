# Public canonical origin. Set to https://your-domain on VPS.
APP_URL=http://localhost:3000
# Caddy listener; use your-domain for automatic HTTPS, :80 locally.
SITE_ADDRESS=:80
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Local development connects to localhost. Compose overrides hostnames internally.
POSTGRES_DB=novel
POSTGRES_USER=novel
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://novel:CHANGE_ME@localhost:5432/novel?connection_limit=10
REDIS_URL=redis://localhost:6379
# Optional Google OAuth; callback: /api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Mailpit locally; real SMTP in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Trang Truyện <noreply@example.com>
# Initial admin and optional development sample accounts. No password is hardcoded.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO=true
SEED_PASSWORD=
# Absolute upload directory in production; Compose sets /app/uploads.
UPLOAD_DIR=./uploads
# Optional error reporting endpoint (Sentry envelope-compatible DSN).
SENTRY_DSN=
LOG_LEVEL=info
